# ─────────────────────────────────────────────────────────────
# OMNOM DAO — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────

# WalletConnect Cloud project ID (https://cloud.walletconnect.com)
NEXT_PUBLIC_WC_PROJECT_ID=""

# HS256 JWT signing secret — MUST be >= 32 chars.
# Generate one: openssl rand -base64 48
JWT_SECRET="please-generate-a-random-secret-of-at-least-32-characters"

# Turso (libSQL) connection URL — `turso db show <name> --url`
TURSO_DATABASE_URL="libsql://omnom-dao-dev.turso.io"

# Turso auth token — `turso db tokens create <name>`
TURSO_AUTH_TOKEN=""

# ── OPTIONAL ──────────────────────────────────────────────────

# Comma-separated admin wallet addresses (checksummed or lowercase)
NEXT_PUBLIC_ADMIN_ADDRESSES=""

# Telegram bot token for @DBOT_DC_BOT notifications (from @BotFather)
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=""

# Resend email API key (https://resend.com) — for transactional email
RESEND_API_KEY=""

# Canonical site URL (used for SIWE domain, OG images, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
