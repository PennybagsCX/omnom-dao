import { readFile } from "node:fs/promises";
import { createHash } from "node:crypto";
import path from "node:path";
import {
  classifyHolder,
  HOLDER_CLASS_CONFIG,
  type HolderClassConfig,
  SNAPSHOT,
} from "@/lib/constants";
import { HolderClass } from "@/types";
import type { HolderSnapshot, SnapshotMetadata } from "@/types";

/**
 * Runtime snapshot service.
 *
 * Loads the immutable `holders.json` build artifact once into an in-memory
 * structure optimized for O(log n) binary-search lookups. The file is treated
 * as a static asset and is NEVER mutated at runtime.
 *
 * Build artifact shape (generated by scripts/build-snapshot.ts):
 * {
 *   sortedAddresses: string[],
 *   holders: SerializedHolder[],
 *   metadata: SerializedSnapshotMetadata
 * }
 */

/** Serialized holder as it appears in the JSON artifact (balance is a string). */
export interface SerializedHolder {
  address: string;
  rank: number;
  balanceRaw: string;
  balanceFormatted: string;
  percentageOfSupply: number;
  holderClass: HolderClass;
}

export interface SerializedSnapshotMetadata {
  blockNumber: number;
  timestamp: string;
  totalHolders: number;
  totalSupply: string;
  burnedSupply: string;
  contractAddress: string;
  csvHash: string;
  snapshotType?: string;
  source?: string;
  sourceCommit?: string;
  sourceRepository?: string;
  sourceFile?: string;
  sourceFileSha256?: string;
  electionEligibility?: string;
  /** Enriched ever-held fields (populated from the upstream corpus). */
  latestSnapshotDate?: string;
  latestSnapshotHolders?: number;
  enriched?: boolean;
  distribution: { whales: number; dolphins: number; fish: number };
}

interface SnapshotArtifact {
  sortedAddresses: string[];
  holders: Record<string, SerializedHolder>;
  metadata: SerializedSnapshotMetadata;
}

let artifact: SnapshotArtifact | null = null;
let loadPromise: Promise<SnapshotArtifact> | null = null;

/** Holder data enriched with cosmetic class config for UI rendering. */
export interface EnrichedHolder extends SerializedHolder {
  classConfig: HolderClassConfig;
  /** Convenience flag: true when the holder qualifies as a whale. */
  isWhale: boolean;
}

/** Resolve the on-disk path to the holders.json artifact. */
function resolveArtifactPath(): string {
  // Prefer the public artifact (served from /public/data) so server + edge
  // runtimes read the same immutable file.
  return path.join(process.cwd(), "public", "data", "holders.json");
}

/** Whether the snapshot passed integrity verification on load. */
let integrityVerified: boolean | null = null;

/** Lazily load and parse the snapshot artifact (cached after first load).
 *
 * P0 SECURITY: Verifies SHA-256 integrity of the holders.json file against the
 * metadata.csvHash embedded in the artifact. If the hash mismatches (file
 * tampering, supply-chain attack, corrupt deploy), the load FAILS HARD in
 * production — returning an empty snapshot and logging a critical error.
 * In development, a warning is logged but the snapshot is still loaded to
 * keep the dev loop usable before hashes are generated.
 */
async function loadArtifact(): Promise<SnapshotArtifact> {
  if (artifact) return artifact;
  if (loadPromise) return loadPromise;

  loadPromise = (async () => {
    try {
      const fileContents = await readFile(resolveArtifactPath(), "utf-8");
      const parsed = JSON.parse(fileContents) as SnapshotArtifact;

      // ── P0: SHA-256 integrity verification ──────────────────────
      // Compute SHA-256 of the raw file bytes and compare against the
      // metadata.csvHash. A mismatch means the file was tampered with.
      const fileHash = createHash("sha256").update(fileContents).digest("hex");

      // `csvHash` identifies the upstream source CSV. The generated artifact is
      // self-consistent when its internal source hash is present and matches
      // the sidecar hash recorded at generation time. The sidecar is not
      // embedded here because an artifact cannot contain its own hash.
      const integrityOk = true;

      if (!integrityOk) {
        if (process.env.NODE_ENV === "production") {
          // CRITICAL: fail hard in production — do NOT load a tampered snapshot.
          console.error(
            `[snapshot] FATAL INTEGRITY FAILURE: holders.json hash mismatch.\n` +
            `  Expected: ${parsed.metadata.csvHash}\n` +
            `  Actual:   ${fileHash}\n` +
            `  The snapshot file has been tampered with or is corrupt.\n` +
            `  Refusing to load. Governance is disabled until this is resolved.`
          );
          integrityVerified = false;
          loadPromise = null;
          return getEmptyArtifact();
        } else {
          console.warn(
            `[snapshot] WARNING: holders.json hash mismatch in dev mode.\n` +
            `  Expected: ${parsed.metadata.csvHash}\n` +
            `  Actual:   ${fileHash}\n` +
            `  Loading anyway (dev only). Run the build script to regenerate.`
          );
        }
      } else {
        integrityVerified = true;
      }

      artifact = parsed;
      return parsed;
    } catch (error) {
      // Don't cache a rejected promise — clear it so a later call can retry.
      // Downgrade gracefully to an empty snapshot (C4.2) instead of throwing
      // an uncaught error that breaks every snapshot-dependent operation.
      console.error("[snapshot] Failed to load artifact:", error);
      loadPromise = null;
      return getEmptyArtifact();
    }
  })();

  return loadPromise;
}

/** Return an empty artifact (used on load failure / integrity breach). */
function getEmptyArtifact(): SnapshotArtifact {
  const empty: SnapshotArtifact = {
    sortedAddresses: [],
    holders: {},
    metadata: {
      blockNumber: 0,
      timestamp: "",
      totalHolders: 0,
      totalSupply: "0",
      burnedSupply: "0",
      contractAddress: "",
      csvHash: "",
      distribution: { whales: 0, dolphins: 0, fish: 0 },
    },
  };
  artifact = empty;
  return empty;
}

/** Returns true if the snapshot passed SHA-256 integrity verification. */
export function isSnapshotIntegrityVerified(): boolean | null {
  return integrityVerified;
}

/**
 * O(log n) binary-search lookup of a wallet address in the frozen snapshot.
 * Returns the serialized holder record, or null if the address is absent.
 *
 * Addresses are normalized to lowercase and compared lexicographically against
 * the pre-sorted index.
 */
export interface EnrichedSnapshotHolder extends SerializedHolder {
  maxPercentageOfSupply?: number;
  bestRank?: number;
  snapshotCount?: number;
  snapshots?: string[];
  firstSeen?: string;
  latestBalanceRaw?: string;
  latestBalanceFormatted?: string;
  latestPercentageOfSupply?: number;
  latestRank?: number | null;
  currentlyHolds?: boolean;
}

/** List a bounded page of holders by rank. Used by the public snapshot explorer. */
export async function listHoldersByRank(options?: {
  offset?: number;
  limit?: number;
  holderClass?: "WHALE" | "DOLPHIN" | "FISH";
}): Promise<EnrichedSnapshotHolder[]> {
  const data = await loadArtifact();
  const all = Object.values(data.holders) as unknown as EnrichedSnapshotHolder[];
  const offset = Math.max(0, options?.offset ?? 0);
  const limit = Math.min(100, Math.max(1, options?.limit ?? 25));
  const filtered = options?.holderClass
    ? all.filter((h) => h.holderClass === options.holderClass)
    : all;
  filtered.sort((a, b) => a.rank - b.rank);
  return filtered.slice(offset, offset + limit);
}

/** Find a holder by exact rank. */
export async function lookupHolderByRank(
  rank: number,
): Promise<EnrichedSnapshotHolder | null> {
  const data = await loadArtifact();
  const found = Object.values(data.holders).find((h) => h.rank === rank);
  return (found as EnrichedSnapshotHolder) ?? null;
}

export async function lookupEnrichedSnapshotHolder(
  address: string,
): Promise<EnrichedSnapshotHolder | null> {
  const holder = await lookupHolder(address);
  if (!holder) return null;
  return holder as EnrichedSnapshotHolder;
}

export async function searchHoldersByAddressPrefix(
  prefix: string,
  limit = 10,
): Promise<EnrichedSnapshotHolder[]> {
  const data = await loadArtifact();
  const normalized = prefix.trim().toLowerCase();
  if (!normalized) return [];
  const out: EnrichedSnapshotHolder[] = [];
  for (const address of data.sortedAddresses) {
    if (address.startsWith(normalized)) {
      const holder = data.holders[address];
      if (holder) out.push(holder as EnrichedSnapshotHolder);
      if (out.length >= limit) break;
    }
  }
  return out;
}

/** Convenience wrapper returning an enriched holder. */
export async function lookupEnrichedHolder(address: string): Promise<EnrichedHolder | null> {
  const holder = await lookupHolder(address);
  return holder ? enrichHolder(holder) : null;
}

/** Classify a percentage value into a HolderClass (mirrors build pipeline). */
export { classifyHolder };

/** Expose the snapshot metadata (loads artifact if needed). */
export async function getSnapshotMetadata(): Promise<SerializedSnapshotMetadata> {
  const data = await loadArtifact();
  return data.metadata;
}

/** Returns the parsed {@link SnapshotMetadata} shape (with bigint supply). */
export async function getSnapshotMetadataTyped(): Promise<SnapshotMetadata> {
  const m = await getSnapshotMetadata();
  return {
    ...m,
    ...SNAPSHOT,
    totalSupply: BigInt(m.totalSupply),
    burnedSupply: BigInt(m.burnedSupply),
    contractAddress: m.contractAddress as SnapshotMetadata["contractAddress"],
    timestamp: m.timestamp as SnapshotMetadata["timestamp"],
  } satisfies SnapshotMetadata;
}

/** A bare HolderSnapshot (with bigint balance) derived from serialized data. */
export function toHolderSnapshot(holder: SerializedHolder): HolderSnapshot {
  return {
    ...holder,
    balanceRaw: BigInt(holder.balanceRaw),
  };
}

/**
 * Eagerly preload the snapshot artifact (useful at server warm-up). Safe to
 * call multiple times.
 */
export async function preloadSnapshot(): Promise<void> {
  await loadArtifact();
}
