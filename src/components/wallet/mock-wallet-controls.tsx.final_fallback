/**
 * Mock Wallet Testing Controls
 * 
 * Visual interface for testing different wallet scenarios in development.
 * Provides account switching, status monitoring, and testing capabilities.
 * 
 * ONLY VISIBLE IN DEVELOPMENT MODE
 */

"use client";

import { useState, useEffect } from "react";
import { Bug, Play, RefreshCw, AlertCircle, CheckCircle, ChevronDown, ChevronUp } from "lucide-react";

import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";

// Dynamic imports to avoid build issues
let enhancedMockWallet: any = null;
let mockAccountTypes: string[] = [];

if (process.env.NODE_ENV === "development") {
  try {
    const module = require("@/config/enhanced-mock-wallet");
    enhancedMockWallet = module;
    mockAccountTypes = module.MOCK_ACCOUNT_TYPES || [];
  } catch (e) {
    console.warn("[MockControls] Enhanced mock wallet not available:", e);
  }
}

interface MockAccountInfo {
  address: string;
  holderClass: string;
  balance: string;
  votingPower: number;
  rank: number;
  displayName: string;
  description: string;
}

export function MockWalletControls() {
  const [isActive, setIsActive] = useState(false);
  const [currentAccount, setCurrentAccount] = useState<MockAccountInfo | null>(null);
  const [allAccounts, setAllAccounts] = useState<Record<string, MockAccountInfo>>({});
  const [isCollapsed, setIsCollapsed] = useState(true);
  const [lastAction, setLastAction] = useState<string>("");

  // Check mock wallet status and load account info
  useEffect(() => {
    if (enhancedMockWallet) {
      const checkStatus = () => {
        const active = enhancedMockWallet.isEnhancedMockWalletActive?.();
        setIsActive(active);
        
        if (active) {
          const current = enhancedMockWallet.getCurrentMockAccount?.();
          const all = enhancedMockWallet.getAllMockAccounts?.();
          setCurrentAccount(current);
          setAllAccounts(all || {});
        }
      };

      checkStatus();
      const interval = setInterval(checkStatus, 2000); // Update every 2 seconds
      return () => clearInterval(interval);
    }
  }, []);

  // Handle account switching
  const handleSwitchAccount = async (accountType: string) => {
    if (!enhancedMockWallet) return;
    
    try {
      const success = enhancedMockWallet.switchMockAccount?.(accountType);
      if (success) {
        setLastAction(`Switched to ${accountType}`);
        // Reload page after short delay to ensure clean state
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } else {
        setLastAction(`Failed to switch to ${accountType}`);
      }
    } catch (error) {
      console.error("Account switch error:", error);
      setLastAction(`Error switching accounts: ${error}`);
    }
  };

  // Only show in development
  if (process.env.NODE_ENV !== "development") {
    return null;
  }

  // Don't show if enhanced mock wallet isn't available
  if (!enhancedMockWallet) {
    return (
      <div className="fixed bottom-4 right-4 z-50">
        <Card className="w-80 border-amber-500 bg-amber-500/10">
          <CardContent className="p-4">
            <div className="flex items-center gap-3">
              <AlertCircle className="h-5 w-5 text-amber-500" />
              <div>
                <p className="text-sm font-medium text-amber-500">Mock Wallet Unavailable</p>
                <p className="text-xs text-muted-foreground">Enhanced mock wallet system not loaded</p>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    );
  }

  return (
    <div className="fixed bottom-4 right-4 z-50">
      <Card className={`w-96 ${isActive ? "border-green-500 bg-green-500/5" : "border-amber-500 bg-amber-500/10"}`}>
        <CardHeader className="pb-3">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2">
              <Bug className="h-5 w-5 text-gold" />
              <CardTitle className="text-sm">Dev Mock Wallet</CardTitle>
              <Badge variant={isActive ? "success" : "warning"} className="text-xs">
                {isActive ? "Active" : "Inactive"}
              </Badge>
            </div>
            <Button
              variant="ghost"
              size="sm"
              onClick={() => setIsCollapsed(!isCollapsed)}
              className="h-6 w-6 p-0"
            >
              {isCollapsed ? (
                <ChevronUp className="h-4 w-4" />
              ) : (
                <ChevronDown className="h-4 w-4" />
              )}
            </Button>
          </div>
        </CardHeader>

        {!isCollapsed && (
          <>
            <CardContent className="space-y-4">
              {/* Current Account Info */}
              {currentAccount && (
                <div className="space-y-2">
                  <div className="flex items-center justify-between">
                    <CardDescription className="text-xs">Current Account</CardDescription>
                    <Badge variant="outline" className="text-xs">
                      {currentAccount.holderClass}
                    </Badge>
                  </div>
                  <div className="rounded-lg border border-border bg-bg-elevated/50 p-3 space-y-1">
                    <p className="text-sm font-medium">{currentAccount.displayName}</p>
                    <p className="text-xs font-mono text-muted-foreground">
                      {currentAccount.address}
                    </p>
                    <div className="flex items-center gap-3 pt-2 text-xs">
                      <span className="text-gold">{currentAccount.balance} tokens</span>
                      <span className="text-muted-foreground">#{currentAccount.rank}</span>
                      <span className="text-success">{currentAccount.votingPower.toLocaleString()} VP</span>
                    </div>
                  </div>
                  <p className="text-xs text-text-dim">{currentAccount.description}</p>
                </div>
              )}

              {/* Account Switcher */}
              <div className="space-y-2">
                <CardDescription className="text-xs">Switch Test Account</CardDescription>
                <Select onValueChange={handleSwitchAccount} defaultValue={currentAccount?.holderClass?.toLowerCase()}>
                  <SelectTrigger className="h-9">
                    <SelectValue placeholder="Select account type" />
                  </SelectTrigger>
                  <SelectContent>
                    {Object.entries(allAccounts).map(([type, account]) => (
                      <SelectItem key={type} value={type}>
                        <div className="flex items-center gap-2">
                          <span>{account.displayName}</span>
                          <Badge variant="outline" className="text-xs ml-2">
                            {account.holderClass}
                          </Badge>
                        </div>
                      </SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              {/* Available Accounts Summary */}
              <div className="space-y-2">
                <CardDescription className="text-xs">Available Test Accounts</CardDescription>
                <div className="grid grid-cols-2 gap-2">
                  {Object.entries(allAccounts).map(([type, account]) => (
                    <div
                      key={type}
                      className="rounded border border-border bg-bg-elevated/30 p-2 text-xs"
                    >
                      <p className="font-medium">{account.displayName}</p>
                      <p className="text-text-dim">{account.balance} tokens</p>
                      <p className="text-text-dim">Rank #{account.rank}</p>
                    </div>
                  ))}
                </div>
              </div>

              {/* Last Action */}
              {lastAction && (
                <div className="flex items-center gap-2 rounded-lg bg-bg-elevated/50 p-2">
                  <CheckCircle className="h-4 w-4 text-success" />
                  <p className="text-xs text-muted-foreground">{lastAction}</p>
                </div>
              )}

              {/* Instructions */}
              <div className="rounded-lg border border-amber-500/30 bg-amber-500/5 p-3">
                <div className="flex items-start gap-2">
                  <AlertCircle className="h-4 w-4 text-amber-500 mt-0.5" />
                  <div className="text-xs text-muted-foreground">
                    <p className="font-medium text-amber-500 mb-1">Development Only</p>
                    <p className="mb-2">
                      This mock wallet is for testing purposes only. It simulates different 
                      holder classes and governance scenarios.
                    </p>
                    <p className="text-text-dim">
                      Switch accounts to test voting power, proposal creation, and UI states 
                      across different holder types.
                    </p>
                  </div>
                </div>
              </div>
            </CardContent>

            <div className="border-t border-border px-6 py-3 bg-bg-elevated/20">
              <div className="flex items-center justify-between text-xs">
                <span className="text-text-dim">Mock Wallet v2.0</span>
                <Button
                  variant="ghost"
                  size="sm"
                  onClick={() => window.location.reload()}
                  className="h-6 text-xs"
                >
                  <RefreshCw className="h-3 w-3 mr-1" />
                  Reload
                </Button>
              </div>
            </div>
          </>
        )}
      </Card>
    </div>
  );
}
