// Emit events to registered listeners
function emit(event: string, payload: unknown) {
  eventListeners.get(event)?.forEach(fn => fn(payload));
  console.log(`[MockWallet] Event emitted: ${event}`, payload);
}

/**
 * Install the enhanced mock wallet provider
 */
export function installEnhancedMockWallet() {
  if (typeof window === "undefined") return false;
  if (process.env.NODE_ENV === "production") {
    console.error("[MockWallet] REFUSED: Attempted to activate in production!");
    return false;
  }

  // Don't override real wallet if present
  // Allow mock wallet to override real wallet in development mode for testing
  if ((window as any).ethereum && !(window as any).ethereum.__isEnhancedMock) {
    console.warn("[MockWallet] Real wallet detected - overriding with mock wallet for development testing");
    // Proceed with mock installation anyway in development mode
  }

  const account = getCurrentAccount();
  const accountKey = privateKeyToAccount(account.privateKey);

  // Enhanced mock provider with full EIP-1193 support
  const provider = {
    __isEnhancedMock: true,
    __isDevMock: true,
    isMetaMask: true,
    isDevMock: true,
    
    // Account management
    __currentAccountType: currentAccountType,
    __mockAccounts: MOCK_ACCOUNTS,
    
    request: async ({ method, params }: { method: string; params?: readonly unknown[] }) => {
      console.log(`[MockWallet] RPC call: ${method}`, params);
      
      switch (method) {
        case "eth_requestAccounts":
        case "eth_accounts": {
          if (method === "eth_requestAccounts") {
            emit("connect", { chainId: "0x7d0" });
            emit("accountsChanged", [account.address]);
          }
          return [account.address];
        }

        case "eth_chainId":
          return "0x7d0"; // Dogechain

        case "personal_sign": {
          const raw = params?.[0];
          let messageStr: string;
          
          if (typeof raw === "string") {
            messageStr = isHexString(raw) ? hexToUtf8(raw) : raw;
          } else if (raw instanceof Uint8Array) {
            messageStr = new TextDecoder().decode(raw);
          } else {
            messageStr = String(raw ?? "");
          }

          console.log(`[MockWallet] Signing message: ${messageStr.substring(0, 50)}...`);
          return await accountKey.signMessage({ message: messageStr });
        }

        case "eth_sign": {
          const raw = params?.[1];
          if (typeof raw === "string" && isHexString(raw)) {
            return await accountKey.signMessage({ message: hexToUtf8(raw) });
          }
          return await accountKey.signMessage({ message: typeof raw === "string" ? raw : String(raw ?? "") });
        }

        case "wallet_switchEthereumChain":
          emit("chainChanged", "0x7d0");
          return null;

        case "wallet_addEthereumChain":
          return null;

        case "net_version":
          return "2000";

        case "eth_getBalance":
          return utf8ToHex(account.balance);

        case "eth_getTransactionCount":
          return "0x0";

        case "eth_blockNumber":
          return "0x1";

        default:
          console.warn(`[MockWallet] Unhandled method: ${method}`);
          return null;
      }
    },

    // Event emitter methods
    on(event: string, handler: Function) {
      if (!eventListeners.has(event)) eventListeners.set(event, new Set());
      eventListeners.get(event)!.add(handler);
      console.log(`[MockWallet] Listener added for: ${event}`);
    },
    
    removeListener(event: string, handler: Function) {
      eventListeners.get(event)?.delete(handler);
    },
    
    emit,
  };

  // Install provider
  Object.defineProperty(window, "ethereum", {
    value: provider,
    writable: true,
    configurable: true,
  });

  if (!devProviderInstalled) {
    devProviderInstalled = true;
    console.log(
      `%c🔧 Enhanced Mock Wallet Active%c\n` +
      `Account: ${account.displayName} (${account.address})\n` +
      `Holder Class: ${account.holderClass} | Balance: ${account.balance} tokens\n` +
      `Rank: #${account.rank} | Voting Power: ${account.votingPower.toLocaleString()}\n` +
      `${account.description}`,
      "background: #FFD700; color: #000; font-weight: bold; padding: 4px 8px; border-radius: 4px;",
      "color: #FFD700; font-weight: bold;"
    );
  }

  return true;
}

/**
 * Switch to a different mock account type
 */
export function switchMockAccount(accountType: MockAccountType) {
  if (!MOCK_ACCOUNTS[accountType]) {
    console.error(`[MockWallet] Invalid account type: ${accountType}`);
    return false;
  }

  const previousType = currentAccountType;
  currentAccountType = accountType;
  const newAccount = getCurrentAccount();

  console.log(
    `%c🔄 Account Switched%c\n` +
    `From: ${MOCK_ACCOUNTS[previousType].displayName}\n` +
    `To: ${newAccount.displayName}\n` +
    `Address: ${newAccount.address}`,
    "background: #FFD700; color: #000; font-weight: bold; padding: 4px 8px; border-radius: 4px;",
    "color: #FFD700; font-weight: bold;"
  );

  // Emit account change event
  const provider = (window as any).ethereum;
  if (provider && provider.__isEnhancedMock) {
    provider.__currentAccountType = accountType;
    emit("accountsChanged", [newAccount.address]);
    
    // Trigger reconnection simulation
    emit("disconnect");
    setTimeout(() => {
      emit("connect", { chainId: "0x7d0" });
      emit("accountsChanged", [newAccount.address]);
    }, 100);
  }

  return true;
}

