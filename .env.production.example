# Required in production
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
JWT_SECRET=""
NEXT_PUBLIC_SITE_URL="https://www.omnom.dog/dao"
NEXT_PUBLIC_WC_PROJECT_ID=""
NEXT_PUBLIC_ADMIN_ADDRESSES="0x22F4194F6706E70aBaA14AB352D0baA6C7ceD24a"

# Recommended for production integrity/rate limiting
KV_REST_API_URL=""
KV_AUTH_TOKEN=""

# Optional
CRON_SECRET=""
RESEND_API_KEY=""
NEXT_PUBLIC_TELEGRAM_BOT_TOKEN=""

# ── Snapshot integrity ────────────────────────────────────────────────
# SHA-256 hash of the frozen holders.json artifact. Set this to the output
# of `npm run fetch:snapshot`. The fetch:snapshot script and this env change
# MUST ship in the same release, or production fails closed on hash mismatch.
SNAPSHOT_SHA256="6cf2ea9f4bcf7cbbef067ad8b453027b1edbe59b2eefc3eaa9b82078b1ff980f"

# ── Dev simulation wallet ────────────────────────────────────────────
# Must be set to "false" in production to disable the in-bundle dev wallet
# stack (enhanced-mock-wallet, dev-auth-bypass, auto-dev-auth-trigger, etc.).
# The source still exists in src/ for E2E/CI use but is gated out at runtime.
NEXT_PUBLIC_ENABLE_DEV_AUTH="false"
